    "width": 390,
    "status": 200,
    "lang": "en",
    "title": "Crispy chickpeas &amp; herby yogurt | My Kitchen",
    "h1": 1,
    "overflow": false,
    "wide": [],
    "canonical": "http://127.0.0.1:8019/en/recipes/crispy-chickpeas-herby-yogurt",
    "structured": [
      [
        {
          "@context": "https://schema.org",
          "@type": "Recipe",
          "@id": "http://127.0.0.1:8019/en/recipes/crispy-chickpeas-herby-yogurt#recipe",
          "url": "http://127.0.0.1:8019/en/recipes/crispy-chickpeas-herby-yogurt",
          "inLanguage": "en",
          "name": "Crispy chickpeas & herby yogurt",
          "description": "A lemony, crunchy bowl that turns a tin of chickpeas into dinner worth sitting down for.",
          "image": [
            "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1400&q=85"
          ],
          "author": {
            "@type": "Person",
            "name": "Chero"
          },
          "datePublished": "2026-11-03T21:05:59+00:00",
          "dateModified": "2026-11-03T21:05:59+00:00",
          "prepTime": "PT10M",
          "cookTime": "PT25M",
          "totalTime": "PT35M",
          "recipeYield": "2",
          "recipeCategory": "Legume Dishes",
          "recipeIngredient": [
            "2 tins of chickpeas, drained and dried",
            "2 tbsp olive oil",
            "1 tsp smoked paprika",
            "200 g Greek yogurt, thick",
            "1 lemon, zested and juiced",
            "A handful each of dill and parsley"
          ],
          "recipeInstructions": [
            {
              "@type": "HowToStep",
              "position": 1,
              "text": "Heat the oven to 220°C / 425°F. Toss the chickpeas with oil, paprika and salt."
            },
            {
              "@type": "HowToStep",
              "position": 2,
              "text": "Roast for 25 minutes, shaking the tray once, until crisp and deeply golden."
            },
            {
              "@type": "HowToStep",
              "position": 3,
              "text": "Stir the yogurt with lemon zest, a squeeze of juice and chopped herbs. Spoon onto plates and tumble over the warm chickpeas."
            }
          ]
        },
